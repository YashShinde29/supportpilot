{
  "name": "@supportpilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test:webhook": "node --env-file-if-exists=.env --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx --test test/webhook.test.ts",
    "ai:check": "node --env-file-if-exists=.env --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx src/ai/check.ts",
    "ai:samples": "node --env-file-if-exists=.env --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx src/ai/check.ts --samples",
    "ai:retry": "node --env-file-if-exists=.env --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx src/ai/retry.ts",
    "agent:create": "node --env-file-if-exists=.env --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx src/auth/create-agent.ts",
    "agent:create-demo": "node --env-file-if-exists=.env --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx src/auth/create-demo-agent.ts",
    "test:agent": "node --env-file-if-exists=.env --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx --test test/agent.test.ts",
    "webhook:send": "node --env-file-if-exists=.env --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx src/webhooks/send-sample.ts",
    "db:create": "node --env-file-if-exists=.env --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx src/db/manage.ts create",
    "db:check": "node --env-file-if-exists=.env --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx src/db/manage.ts check",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx src/db/migrate.ts up",
    "db:status": "node --env-file-if-exists=.env --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx src/db/migrate.ts status",
    "db:verify": "node --env-file-if-exists=.env --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx src/db/verify.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@google/genai": "^2.32.0",
    "fastify": "5.12.7",
    "pg": "^8.23.1",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "tsx": "^4",
    "typescript": "~5.9.3"
  }
}
